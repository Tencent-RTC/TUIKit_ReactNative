# ========================================
# React Native Monorepo .gitignore
# ========================================

# ==================== Dependencies ====================
# Node modules
node_modules/
**/node_modules/

# Yarn Berry (v2+)
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions
.pnp.*

# ==================== OS Files ====================
# macOS
.DS_Store
.AppleDouble
.LSOverride

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# Linux
*~

# ==================== IDE & Editors ====================
# VSCode
.vscode/
jsconfig.json
*.code-workspace

# JetBrains IDEs (WebStorm, IntelliJ)
.idea/
*.iml
*.ipr
*.iws

# Vim
*.swp
*.swo
*~

# Emacs
*~
\#*\#
.\#*

# ==================== React Native ====================
# Metro bundler
.metro-health-check*

# Expo
.expo/
.expo-shared/
web-build/

# Watchman
.watchmanconfig

# ==================== iOS ====================
# Xcode
ios/build/
**/ios/build/
ios/Pods/
**/ios/Pods/
ios/*.xcworkspace/xcuserdata/
**/ios/*.xcworkspace/xcuserdata/
ios/*.xcodeproj/xcuserdata/
**/ios/*.xcodeproj/xcuserdata/
ios/*.xcodeproj/project.xcworkspace/
**/ios/*.xcodeproj/project.xcworkspace/
ios/DerivedData/
**/ios/DerivedData/
*.pbxuser
!default.pbxuser
*.mode1v3
!default.mode1v3
*.mode2v3
!default.mode2v3
*.perspectivev3
!default.perspectivev3
*.hmap
*.ipa
*.xcuserstate
**/.xcode.env.local

# CocoaPods
ios/Pods/
**/ios/Pods/
Podfile.lock
**/Podfile.lock

# ==================== Android ====================
# Gradle
.gradle/
android/.gradle/
**/android/.gradle/
android/.cxx/
**/android/.cxx/
android/build/
**/android/build/
android/app/build/
**/android/app/build/
android/captures/
**/android/captures/
*.apk
*.aab

# Android app module (build outputs and generated files)
**/android/app/.cxx/
**/android/app/build/
**/android/app/libs/*.so
**/android/app/src/main/assets/index.android.bundle
**/android/app/src/main/assets/index.android.bundle.meta
**/android/.kotlin/
**/android/libs/*.aar

# Android Studio
android/.idea/
**/android/.idea/
android/local.properties
*.iml
.externalNativeBuild
.cxx

# Keystore files (IMPORTANT: Never commit!)
*.jks

# ==================== Build Outputs ====================
# Generated libraries
lib/
dist/
build/

# React Native Codegen
ios/generated/
android/generated/

# React Native Nitro Modules
nitrogen/

# Turborepo cache
.turbo/

# ==================== Logs ====================
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
*.log

# ==================== Environment & Config ====================
# Environment variables
.env
.env.local
.env.*.local
.env.development.local
.env.test.local
.env.production.local



# ==================== Ruby (for iOS development) ====================
# Bundler
vendor/bundle/
**/vendor/bundle/
.bundle/
**/.bundle/
*.gem
Gemfile.lock

# ==================== Testing ====================
# Coverage
coverage/
*.lcov
.nyc_output

# Test results
test-results/
junit.xml

# ==================== Temporary Files ====================
tmp/
temp/
*.tmp
*.cache

# ==================== BUCK ====================
buck-out/
.buckd/
android/app/libs
**/android/app/libs

# ==================== Misc ====================
# Lock files (keep yarn.lock for consistency)
# package-lock.json
# pnpm-lock.yaml

# Debug files
*.tsbuildinfo
